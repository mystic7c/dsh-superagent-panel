      "html": "<div class=\"ds-segmented\" role=\"radiogroup\"><button class=\"ds-segment\" role=\"radio\" aria-checked=\"true\">已订阅 4 条</button><button class=\"ds-segment\" role=\"radio\" aria-checked=\"false\">已忽略 0 条</button></div>",
      "css": ".ds-segmented{display:inline-grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:2px;padding:2px;border-radius:999px;background:var(--dsw-alias-bg-layer-2);box-shadow:inset 0 0 0 1px var(--sa-line,var(--dsw-alias-border-l2))}.ds-segment{height:28px;padding:0 12px;border:0;border-radius:999px;background:transparent;color:var(--dsw-alias-label-secondary);font:inherit;font-size:13px;line-height:1.5;font-weight:500;cursor:pointer}.ds-segment[aria-checked=\"true\"]{background:var(--dsw-alias-bg-base,var(--dsw-alias-bg-layer-1));color:var(--dsw-alias-label-primary);box-shadow:var(--dsw-elevation-soft,0 1px 2px transparent)}.ds-segment:focus-visible{outline:2px solid var(--dsw-focus-ring-color,var(--dsw-alias-brand-primary));outline-offset:-2px}"
