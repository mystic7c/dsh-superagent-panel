      "html": "<div class=\"ds-row\"><button class=\"ds-row-open\"><span class=\"ds-row-title\">下发工单解决问题：移动端 500–600px 时头部溢出</span><span class=\"ds-row-meta\">tkt_4e4c8a25 · 5 分钟前</span></button><span class=\"ds-badge\">已合并</span></div>",
      "css": ".ds-row{position:relative;display:flex;flex-wrap:wrap;align-items:flex-start;gap:4px 12px;padding:8px 8px 10px;border-radius:8px}.ds-row:hover{background:var(--dsw-alias-interactive-bg-hover,var(--dsw-alias-bg-layer-2))}.ds-row-open{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:4px;padding:0;border:0;background:transparent;color:inherit;font:inherit;text-align:left;cursor:pointer}.ds-row-open:focus-visible{outline:2px solid var(--dsw-focus-ring-color,var(--dsw-alias-brand-primary));outline-offset:-2px;border-radius:4px}.ds-row-title{font-size:15px;line-height:1.35;font-weight:600;color:var(--dsw-alias-label-primary)}.ds-row-meta{font-size:12px;line-height:1.4;color:var(--sa-label-tertiary,var(--dsw-alias-label-tertiary));font-variant-numeric:tabular-nums}.ds-badge{display:inline-flex;align-items:center;min-height:18px;padding:0 8px;border:0.5px solid var(--sa-line,var(--dsw-alias-border-l2));border-radius:999px;font-size:11px;line-height:1.4;color:var(--sa-label-tertiary,var(--dsw-alias-label-tertiary))}"
