      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:4px;border:none;border-radius:var(--sa-r-sm,4px);padding:0 var(--sa-sp-12,12px);height:32px;font:inherit;font-size:var(--sa-fs-body,13px);line-height:1;font-weight:500;cursor:pointer}.ds-btn:focus-visible{outline:2px solid var(--dsw-focus-ring-color,var(--dsw-alias-brand-primary));outline-offset:2px}.ds-btn-primary{background:var(--dsw-alias-button-primary-fill,var(--dsw-alias-brand-primary));color:var(--dsw-alias-label-primary-foreground)}.ds-btn-primary:hover{background:var(--dsw-alias-button-primary-hover,var(--dsw-alias-brand-primary))}"
