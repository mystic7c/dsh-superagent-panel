{
  "name": "@mystic7c/dsh-superagent-panel",
  "version": "1.0.23",
  "type": "module",
  "description": "Superagent \u7ba1\u7406\u9762\u677f\uff1a\u5f85\u529e/\u5de5\u5355/\u8fd0\u884c\u89c2\u6d4b/\u81ea\u52a8\u5316/\u9a8c\u6536/\u6765\u6e90\u4e0e\u90e8\u7f72\u8bbe\u7f6e\uff08DSH \u63d2\u4ef6\uff09\u3002",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mystic7c/dsh-superagent-panel.git"
  },
  "homepage": "https://github.com/mystic7c/dsh-superagent-panel#readme",
  "bugs": {
    "url": "https://github.com/mystic7c/dsh-superagent-panel/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "client/index.js",
    "client/index.js.map",
    "client/src/**/*.js",
    "scripts/**/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/**/*.md",
    "CHANGELOG.md",
    "test/fixtures/**/*.json",
    "types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node --check index.js && node scripts/build-client.mjs --check",
    "types": "tsc -p tsconfig.json",
    "test": "node --test lib/live/*.test.js",
    "verify": "node scripts/build-client.mjs --check && node scripts/check-keys.mjs",
    "dev": "node scripts/dev.mjs",
    "check:js": "tsc -p tsconfig.check.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "superagent",
    "agent",
    "ticket",
    "operations"
  ],
  "devDependencies": {
    "@types/node": "22.19.1",
    "esbuild": "0.28.2",
    "jsdom": "24.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
