{
  "name": "@mystic7c/dsh-superagent-panel",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Superagent 管理面板：待办/工单/运行观测/自动化/验收/来源与部署设置（DSH 插件）。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mystic7c/dsh-superagent-panel.git"
  },
  "homepage": "https://github.com/mystic7c/dsh-superagent-panel#readme",
  "bugs": {
    "url": "https://github.com/mystic7c/dsh-superagent-panel/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "client/index.js",
    "client/index.js.map",
    "client/src/**/*.js",
    "scripts/**/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/**/*.md",
    "CHANGELOG.md",
    "test/fixtures/**/*.json",
    "types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node --check index.js && node scripts/build-client.mjs --check",
    "types": "tsc -p tsconfig.json",
    "test": "node --test lib/store.test.js lib/live/*.test.js",
    "verify": "node scripts/build-client.mjs --check && node scripts/check-keys.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "superagent",
    "agent",
    "ticket",
    "operations"
  ],
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "24.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  }
}
