{
  "//": "checkJs 清单：Host 半与客户端入口全部入档（0.9.12 起）。修好一个新文件就加进 files；不要为了让绿灯移除文件。",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "React.Fragment",
    "strict": false,
    "noImplicitAny": false
  },
  "files": [
    "types/dsh.d.ts",
    "index.js",
    "lib/util.js",
    "lib/live/repo.js",
    "lib/live/worker-tools.js",
    "lib/live/workflow.js",
    "lib/live/workflow-worker.js",
    "lib/live/acceptance.js",
    "lib/live/evidence.js",
    "lib/live/operations.js",
    "lib/live/worker-cli.js",
    "lib/live/review-json.js",
    "lib/live/diff.js",
    "lib/live/github.js",
    "lib/live/routing.js",
    "lib/live/eval.js",
    "lib/live/judge.js",
    "lib/live/octo.js",
    "lib/live/gitlab.js",
    "lib/live/repos.js",
    "lib/live/config.js",
    "lib/live/signals.js",
    "lib/live/inbox.js",
    "lib/live/live-json.js",
    "lib/live/worker.js",
    "lib/live/engine.js",
    "lib/live/shadow.js",
    "client/src/index.js"
  ]
}
